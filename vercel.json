{
  "crons": [
    {
      "path": "/api/notify",
      "schedule": "0 23 * * 0"
    }
  ],
  "rewrites": [
    {
      "source": "/:page(about|activities|artist|artists|calendar|catalogs|call|calls|en|guide|history|info|join|places|plan|president|press|privacy|programs|support|tools)",
      "destination": "/:page.html"
    }
  ],
  "redirects": [
    {
      "source": "/:path((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "kcap.vercel.app"
        }
      ],
      "destination": "https://www.xn--3e0bw6eoulc8g38eepcq2oc6r0pbbtmt.kr/:path",
      "permanent": true
    },
    {
      "source": "/tools",
      "destination": "/info",
      "permanent": false
    },
    {
      "source": "/tools.html",
      "destination": "/info",
      "permanent": false
    },
    {
      "source": "/index",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:page(about|activities|artist|artists|calendar|catalogs|call|calls|en|guide|history|info|join|places|plan|president|press|privacy|programs|support|tools)/",
      "destination": "/:page",
      "permanent": true
    }
  ]
}
